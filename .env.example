# Copy this file to .env.local and fill in your Firebase project values.
# Get these from Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials for authenticated API routes.
FIREBASE_PROJECT_ID=
FIREBASE_SA_CLIENT_EMAIL=
FIREBASE_SA_PRIVATE_KEY=

# Set to "dev" to use isolated dev_ prefixed collections in Firestore.
# Leave empty or "prod" for production data.
VITE_ENV=dev

# Admin email — this user gets access to backups, restore, dev tools,
# salary data import, and the danger zone (reset all data).
# Leave empty to hide admin features from all users.
VITE_ADMIN_EMAIL=

# Server-only AI Advisor keys. Configure these in Vercel; never prefix with VITE_.
GEMINI_API_KEY=
GROQ_API_KEY=

# Resend email reminders — get a free API key at https://resend.com
# Free tier: 3,000 emails/month. Daily cron sends per-household emails.
# Reminder email is configured per household in Settings → Notifications.
RESEND_API_KEY=