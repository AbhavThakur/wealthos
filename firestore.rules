rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "abhav.aanya@gmail.com";
    }

    match /households/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // GrowthOS sync — users can read/write their own growthOS data
    // WealthOS writes wealthSnapshot here; GrowthOS reads it.
    match /users/{userId}/growthOS/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Feedback collection - users can create and read their own, admin can read/write all
    match /feedback/{feedbackId} {
      // Anyone authenticated can create feedback
      allow create: if request.auth != null;
      
      // Users can read their own feedback, admin can read all
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         request.auth.token.email == "abhav.aanya@gmail.com");
      
      // Admin can update any, users can only update their own (for marking read)
      allow update: if request.auth != null && 
        (request.auth.token.email == "abhav.aanya@gmail.com" ||
         resource.data.userId == request.auth.uid);
      
      // Only admin can delete feedback
      allow delete: if request.auth != null && 
        request.auth.token.email == "abhav.aanya@gmail.com";
    }
    
    // Notifications collection — admin sends, all authenticated users read
    match /notifications/{notificationId} {
      // Any authenticated user can read notifications
      allow read: if request.auth != null;
      
      // Users may only add their own UID to readBy or dismissedBy.
      allow update: if isAdmin() || (request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.hasAll(resource.data.readBy) &&
          request.resource.data.readBy.hasAll([request.auth.uid]) &&
          request.resource.data.readBy.size() == resource.data.readBy.size() + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedBy']) &&
          request.resource.data.dismissedBy.hasAll(resource.data.get('dismissedBy', [])) &&
          request.resource.data.dismissedBy.hasAll([request.auth.uid]) &&
          request.resource.data.dismissedBy.size() == resource.data.get('dismissedBy', []).size() + 1)
      ));
      
      // Only admin can create notifications
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
